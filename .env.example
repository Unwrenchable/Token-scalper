# =============================================================================
# AI ANALYSIS API KEY (Optional)
# =============================================================================
# For AI-powered token analysis and risk assessment
# Supported providers: 'openai' (GPT-4) or 'anthropic' (Claude)
# AI_API_KEY="your_openai_or_anthropic_api_key_here"

# =============================================================================
# SECURITY NOTES
# =============================================================================
# - NEVER share or commit your .env file
# - NEVER share your private keys with anyone
# - Use separate wallets for bot trading (don't use your main wallet)
# - Consider using hardware wallets or key management services in production
# - Regularly rotate private keys if they may have been exposed
